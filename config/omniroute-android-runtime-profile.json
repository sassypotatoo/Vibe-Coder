{
  "build": {
    "build_command": [
      "npm",
      "run",
      "build:backend"
    ],
    "environment": {
      "OMNIROUTE_BUILD_BACKEND_ONLY": "1",
      "OMNIROUTE_BUILD_PROFILE": "minimal",
      "OMNIROUTE_MITM_STUB": "1",
