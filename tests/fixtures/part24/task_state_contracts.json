{
  "schema": 1,
  "catalog_cases": [
    {
      "name": "exact_primary_identity",
      "catalog": [
        { "id": "alpha/code", "display_name": null, "provider": "alpha" }
      ],
      "expected": "accepted",
      "expected_error": null
    },
    {
      "name": "primary_absent",
      "catalog": [
        { "id": "beta/code", "display_name": null, "provider": "beta" }
      ],
      "expected": "missing",
      "expected_error": null
    },
    {
      "name": "same_id_wrong_provider",
      "catalog": [
        { "id": "alpha/code", "display_name": null, "provider": "other" }
      ],
      "expected": "error",
      "expected_error": "agent_catalog_identity_mismatch"
    },
    {
      "name": "duplicate_agent_model_id",
      "catalog": [
        { "id": "alpha/code", "display_name": null, "provider": "alpha" },
        { "id": "alpha/code", "display_name": null, "provider": "alpha" }
      ],
      "expected": "error",
      "expected_error": "ambiguous_agent_catalog_model_id"
    },
    {
      "name": "agent_provider_missing",
      "catalog": [
        { "id": "alpha/code", "display_name": null, "provider": null }
      ],
      "expected": "error",
      "expected_error": "agent_model_provider_missing"
    }
  ],
  "active_identity_cases": [
    {
      "name": "active_identity_exact",
      "active": { "id": "alpha/code", "display_name": null, "provider": "alpha" },
      "expected": "accepted",
      "expected_error": null
    },
    {
      "name": "active_model_id_changed",
      "active": { "id": "other/code", "display_name": null, "provider": "alpha" },
      "expected": "error",
      "expected_error": "agent_active_identity_mismatch"
    },
    {
      "name": "active_provider_changed",
      "active": { "id": "alpha/code", "display_name": null, "provider": "other" },
      "expected": "error",
      "expected_error": "agent_active_identity_mismatch"
    },
    {
      "name": "active_provider_missing",
      "active": { "id": "alpha/code", "display_name": null, "provider": null },
      "expected": "error",
      "expected_error": "agent_model_provider_missing"
    }
  ],
  "progress_cases": [
    { "name": "no_event_allows_configured_fallback", "event": "none", "failure": "model_unavailable", "expected": "retry" },
    { "name": "message_accepted_is_not_progress", "event": "message_accepted", "failure": "model_unavailable", "expected": "retry" },
    { "name": "warning_is_not_progress", "event": "warning", "failure": "model_unavailable", "expected": "retry" },
    { "name": "text_delta_blocks_replay", "event": "text_delta", "failure": "model_unavailable", "expected": "stop_observable_progress" },
    { "name": "background_progress_blocks_replay", "event": "background_progress", "failure": "model_unavailable", "expected": "stop_observable_progress" },
    { "name": "tool_start_blocks_replay", "event": "tool_started", "failure": "model_unavailable", "expected": "stop_observable_progress" },
    { "name": "tool_finish_blocks_replay", "event": "tool_finished", "failure": "model_unavailable", "expected": "stop_observable_progress" },
    { "name": "unknown_failure_never_replays", "event": "none", "failure": "unknown", "expected": "stop_not_safe" }
  ],
  "completion_cases": [
    { "name": "normal_turn_completes", "cancelled": false, "expected": "success" },
    { "name": "cancelled_turn_fails_closed", "cancelled": true, "expected": "cancelled" }
  ]
}
